// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "diff_view_style": "unified",
  "format_on_save": "on",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": true
    },
    "provider": "copilot",
  },
  "formatter": [
    {
      "code_action": "sourse.fixAll.eslint",
    },
    "prettier",
  ],
  "theme": {
    "mode": "dark",
    "light": "Ayu Mirage",
    "dark": "Ayu Mirage",
  },
  "buffer_font_size": 16,
  "buffer_line_height": {
    "custom": 2,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "language_models": {
    // Work Profile
    "bedrock": {
      "authentication_method": "named_profile",
      "region": "us-east-1",
      "profile": "cg-bedrock",
    },
  },
  "terminal": {
    "line_height": "comfortable",
    "font_family": "JetBrainsMono Nerd Font",
  },
}
